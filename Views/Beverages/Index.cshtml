@model IEnumerable<FoodHub.Models.Beverage>

<div style="background-color:#cdcdcd; min-height:100vh; padding:40px;">
    <h2 class="text-center mb-4">Our Beverages</h2>
    <div class="row g-4 align-items-stretch"> <!-- stretch columns -->
        @foreach (var beverage in Model)
        {
            <div class="col-md-3 mb-4 d-flex"> <!-- make column flex to fill height -->
                <div class="card shadow-sm border-0 beverage-card text-center flex-fill d-flex flex-column">
                    <img src="uploads/beverages/@beverage.ImageName" class="card-img-top-bvg" alt="@beverage.Name" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title" style="min-height:50px;">@beverage.Name</h5>
                        <p class="card-text flex-grow-1">@beverage.Description</p>

                        <button class="btn btn-warning fw-bold mt-auto w-100 d-flex justify-content-between align-items-center add-to-cart"
                                data-type="beverage"
                                data-id="@beverage.Id"
                                data-name="@beverage.Name"
                                data-price="@beverage.Price">
                            <span>ADD</span>
                            <span>$@beverage.Price</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts { 
    <script src="~/js/cart.js"></script> 
    <script> 
        document.addEventListener("DOMContentLoaded", function () { 
            document.querySelectorAll(".add-to-cart").forEach(btn => {
                btn.addEventListener("click", function () {
                    const id = this.dataset.id;
                    const name = this.dataset.name;
                    const type = this.dataset.type;   // "beverage"
                    const price = parseFloat(this.dataset.price);

                    addToCart(id, name, type, price);
                });
            });
        }); 
    </script> 
}  