@model List<FoodHub.ViewModels.PresentDriverVM>

@{
    ViewData["Title"] = "Delivery Persons";
   Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
<h2>Attendance History</h2>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Driver ID</th>
            <th>Name</th>
            <th>NIC</th>
            <th>Check In Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.DeliveryPersonId</td>
                <td>@d.Name</td>
                <td>@d.NIC</td>
                <td>@(d.CheckInTime?.ToString("hh:mm tt") ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center">
        <a asp-action="Index" class="btn btn-secondary mt-2; width: 10%">Back</a>
         <div>
        <a asp-area="Admin"
            asp-controller="Dashboard"
            asp-action="Index"
            class="btn btn-primary">
                Dashboard
            </a>
        </div>
    </div>
</div>
