@model IEnumerable<FoodHub.Models.DeliveryPerson>
@{
    ViewData["Title"] = "Delivery Persons";
   Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
     <h2 class="text-center mb-4 fw-bold text-warning">Delivery Person Management</h2>

    <!-- Register Button -->
     <!-- Navigation button -->
    <div class="d-flex justify-content-end gap-2 mb-3">

        <div>
        <a asp-area="Admin"
            asp-controller="Dashboard"
            asp-action="Index"
            class="btn btn-primary">
                Dashboard
            </a>
        </div>

        <div class="text-end mb-3">
            <a asp-area="Admin" asp-controller="DeliveryPerson" asp-action="Register" class="btn btn-warning">
                + Register Delivery Person
            </a>
        </div>
        <div>
            <a asp-area="Admin"
                asp-controller="DeliveryPerson"
                asp-action="PresentDrivers"
                class="btn btn-success">
                Attendance
            </a>
        </div>
        <div>
            <a asp-area="Admin"
                asp-controller="DeliveryPerson"
                asp-action="PresentDriversHistory"
                class="btn btn-info">
                Attendance History
            </a>
        </div>
        <div>
            <a asp-area="Admin"
                asp-controller="DeliveryPerson"
                asp-action="DeliveryAssign"
                class="btn btn-info">
                Delivery Assigns
            </a>
        </div>
    </div>
    

   

     


    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No users found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>NIC</th>
                        <th>Phone</th>
                        <th>FingerPrint Enabled</th>
                        <th>Created</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.NIC</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.FingerprintEnabled</td>
                            <td>@user.CreatedAt.ToString("dd-MMM-yyyy")</td>
                            <td class="text-center">
                               <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Edit</a>


                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
