@model List<FoodHub.ViewModels.PresentDriverVM>

@{
    ViewData["Title"] = "Delivery Persons";
   Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var sriLankaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Colombo");
    var sriLankaNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, sriLankaTimeZone);
}

<div class="container mt-5">
    <h2>    
        Present Drivers Today
        <small class="text-muted">
            (@sriLankaNow.ToString("yyyy-MM-dd HH:mm:ss"))
        </small>
    </h2>

      <div class="d-flex justify-content-end gap-2 mb-3">
        <div class="text-center">
            <a asp-action="Index" class="btn btn-secondary mt-2; width: 10%">Back</a>
        </div>
        <div class="text-center">
            <a asp-area="Admin"
                asp-controller="Dashboard"
                asp-action="Index"
                class="btn btn-primary">
                    Dashboard
            </a>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Driver ID</th>
                <th>Name</th>
                <th>NIC</th>
                <th>Check In Time</th>
                <th>Check Out Time</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.DeliveryPersonId</td>
                    <td>@d.Name</td>
                    <td>@d.NIC</td>
                    <td>@(d.CheckInTime?.ToString("hh:mm tt") ?? "-")</td>
                    <td>@(d.CheckOutTime?.ToString("hh:mm tt") ?? "-")</td>
                    <td>@(d.Date?.ToString("dd-MM-yyyy") ?? "-")</td>

                </tr>
            }
        </tbody>
    </table>

  
</div>
